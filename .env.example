# Copy this file to `.env` and fill in the values you need.
# The MCP server reads these on startup. Nothing here is secret-by-itself;
# secrets (AWS creds) live in your ~/.aws/credentials file, not here.

# --- AWS ---------------------------------------------------------------------
# Which named profile from ~/.aws/credentials to use.
# Run `aws configure list-profiles` to see what you have available.
AWS_PROFILE=default

# Default region for AWS API calls when a tool doesn't override it.
AWS_REGION=us-east-1

# --- Server behaviour --------------------------------------------------------
# Log level for the server's own stderr logging. DEBUG | INFO | WARNING | ERROR
DEVSTACK_MCP_LOG_LEVEL=INFO
